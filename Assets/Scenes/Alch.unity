  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9e4c41630b8f7d4480635cec0033bbe, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: Solan Hollis
  dialogueLines:
  - mainText: Woher hast du das?
    mainTClip: {fileID: 8300000, guid: 42c94707ffe08094db268ff53b7dd4bf, type: 3}
    extraTexts: []
    extraTClips: []
    options:
    - optionText: ...
      nextDialogueIndex: 1
  - mainText: ...
    mainTClip: {fileID: 8300000, guid: 2a0da77ef0bfab143aed0f7845c94ba0, type: 3}
    extraTexts: []
    extraTClips: []
    options:
    - optionText: ...
      nextDialogueIndex: 2
  - mainText: "Deinem Vater? Du bist Flints Sohn? Ich k\xF6nnte dir weiterhelfen
      - aber nat\xFCrlich nur f\xFCr eine Gegenleistung..."
    mainTClip: {fileID: 8300000, guid: 48cb87b56b7490d4fb524cb9d237f859, type: 3}
    extraTexts: []
    extraTClips: []
    options:
    - optionText: ...
      nextDialogueIndex: 3
  - mainText: ...
    mainTClip: {fileID: 8300000, guid: c6189811ceb87c64a8f747d8d2c87db7, type: 3}
    extraTexts: []
    extraTClips: []
    options:
    - optionText: ...
      nextDialogueIndex: 4
  - mainText: "Geh zu Tiffany und nimm ein paar der ausgeh\xE4ngten Auftr\xE4ge an,
      dann kommst du sicher irgendwann an Geld. Ich will 250 M\xFCnzen"
    mainTClip: {fileID: 8300000, guid: 447d827aaf4cf7647bf962297703a68b, type: 3}
    extraTexts: []
    extraTClips: []
    options: []
  playerMoveNew: {fileID: 2016177466}
